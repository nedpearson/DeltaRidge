# ---------------------------------------------------------------------------
# Delta Ridge Field — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# Only VITE_* vars reach the browser. Everything else is server-side only
# (Supabase Edge Functions) and must never be prefixed with VITE_.
# ---------------------------------------------------------------------------

# --- Supabase (client-safe) ---
VITE_SUPABASE_URL=https://udrxvpkihkbrudvwggpr.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server-side only: Edge Functions / CI) ---
# Never expose this to the frontend. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox ---
# Public token (pk.*) is client-safe. Restrict it by URL in the Mapbox dashboard.
VITE_MAPBOX_PUBLIC_TOKEN=
# Secret token (sk.*) for server-side Directions/Matrix batching, if used.
MAPBOX_SECRET_TOKEN=

# --- Storm intelligence ---
# Which StormProvider to use: 'noaa' (free, public) | 'hailtrace' | 'none'
VITE_STORM_PROVIDER=noaa
# HailTrace: requires a paid subscription + API credentials from HailTrace sales.
# Leave blank — the app degrades to the NOAA provider automatically.
HAILTRACE_API_KEY=
HAILTRACE_APP_ID=

# --- CRM / office handoff ---
# Write path into Roofr is via CompanyCam (bidirectional Roofr<->CompanyCam sync).
# Requires a CompanyCam Pro, Premium, or Elite plan.
# Mode: 'companycam' | 'pdf_email' | 'disabled'
VITE_HANDOFF_MODE=pdf_email
COMPANYCAM_API_TOKEN=
COMPANYCAM_DEFAULT_USER_EMAIL=
# Inbound Roofr events arrive via Zapier webhook (Roofr -> us is one-way only).
ROOFR_WEBHOOK_SECRET=

# --- AI provider ---
# 'anthropic' | 'openai' | 'none'  ('none' disables AI assist, app still works)
VITE_AI_PROVIDER=none
AI_API_KEY=
AI_VISION_MODEL=claude-sonnet-4-6
AI_TEXT_MODEL=claude-sonnet-4-6

# --- Notifications (optional) ---
RESEND_API_KEY=
OFFICE_NOTIFY_EMAIL=

# --- Observability (optional) ---
VITE_SENTRY_DSN=
