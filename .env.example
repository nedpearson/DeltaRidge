# ---------------------------------------------------------------------------
# Delta Ridge Field — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# Only VITE_* vars reach the browser. Everything else is server-side only
# (Supabase Edge Functions) and must never be prefixed with VITE_.
# ---------------------------------------------------------------------------

# --- Supabase (client-safe) ---
VITE_SUPABASE_URL=https://udrxvpkihkbrudvwggpr.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server-side only: Edge Functions / CI) ---
# Never expose this to the frontend. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox ---
# Public token (pk.*) is client-safe. Restrict it by URL in the Mapbox dashboard.
VITE_MAPBOX_PUBLIC_TOKEN=
# Secret token (sk.*) for server-side Directions/Matrix batching, if used.
MAPBOX_SECRET_TOKEN=

# --- Storm intelligence ---
# Ground reports. Which StormProvider to use: 'noaa' (free, public) | 'hailtrace' | 'none'
VITE_STORM_PROVIDER=noaa
#
# Radar-estimated hail, running ALONGSIDE ground reports, never instead of them.
#   'swdi' — NOAA NCEI Severe Weather Data Inventory, NEXRAD Level-III hail
#            detection (nx3hail). Free, public domain, no key, no account, and
#            CORS-open, so the browser reads it directly and no server is needed.
#   'off'  — ground reports only.
#
# This is what finally closed out "MRMS/MESH: NOT CONFIGURED". Gridded MRMS MESH
# is still not wired up and still cannot be: it ships GRIB2 on S3 and a browser
# cannot decode it. SWDI answers the same question in CSV.
#
# Caveat worth keeping in front of you: MEHS estimates hail ALOFT and
# over-predicts in this market. Over the service area for the 24 months to
# 2026-09-24, 12.6% of cell-days at 1.0"+ had a ground report within 15 km the
# same day; 21.6% at 1.25"; 33.8% at 1.5". Hence the separate, higher size floor
# for radar in the lead engine (radarMinHailInches, default 1.25").
VITE_RADAR_HAIL=swdi
# HailTrace: requires a paid subscription + API credentials from HailTrace sales.
# Leave blank — the app degrades to the NOAA provider automatically.
HAILTRACE_API_KEY=
HAILTRACE_APP_ID=

# --- CRM / office handoff ---
# Write path into Roofr is via CompanyCam (bidirectional Roofr<->CompanyCam sync).
# Requires a CompanyCam Pro, Premium, or Elite plan.
# Mode: 'companycam' | 'pdf_email' | 'disabled'
VITE_HANDOFF_MODE=pdf_email
COMPANYCAM_API_TOKEN=
COMPANYCAM_DEFAULT_USER_EMAIL=
# --- Roofr, through Zapier ---
# Neither of these belongs in this file on a real machine and neither belongs in
# the browser bundle. They are Supabase Edge Function secrets, set with
#   supabase secrets set NAME=value
# and listed here only so it is obvious what the integration needs. src/lib/env.ts
# refuses to start the app if either ever appears with a VITE_ prefix.
#
# INBOUND (Roofr -> Zapier -> us) does NOT use an env var at all. The credential
# is per-organisation, generated in Manager -> Roofr, shown once, and stored only
# as a SHA-256 hash in roofr_settings. The Zap sends it as the header
# x-delta-ridge-token. There is deliberately no way to recover it; replace it.
#
# OUTBOUND (us -> Zapier -> Roofr) needs the URL of a "Catch Hook" trigger in the
# Zap that calls Roofr's Create Job and Customer action. Anyone holding this URL
# can create records in the company's CRM, so it is a secret in the same sense a
# password is.
ZAPIER_ROOFR_HOOK_URL=

# Superseded. The inbound credential is per-organisation and lives in the
# database as a hash (see above); this variable is no longer read by anything.
# Kept for one release so an existing deployment does not fail a config diff.
ROOFR_WEBHOOK_SECRET=

# --- AI provider ---
# 'anthropic' | 'openai' | 'none'  ('none' disables AI assist, app still works)
VITE_AI_PROVIDER=none
AI_API_KEY=
AI_VISION_MODEL=claude-sonnet-4-6
AI_TEXT_MODEL=claude-sonnet-4-6

# --- Notifications (optional) ---
RESEND_API_KEY=
OFFICE_NOTIFY_EMAIL=

# --- Observability (optional) ---
VITE_SENTRY_DSN=
