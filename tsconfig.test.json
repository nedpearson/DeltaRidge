{
  /*
   * The tests are TypeScript too, and until now nothing checked them.
   *
   * `tsconfig.app.json` includes only `src`, so a test could construct a row
   * with a missing field, or call a function with the wrong shape, and the
   * build stayed green. That is a smaller version of the bug that made
   * `npm run typecheck` a no-op for the first fortnight of this project: a
   * check that passes because it is looking at nothing.
   */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals", "node"]
  },
  /*
   * The Edge Functions' PURE modules are typechecked here too.
   *
   * Only `events.ts` and `payload.ts` — never the `index.ts` beside them, which
   * imports `npm:` specifiers and calls Deno globals that do not exist in this
   * project's type environment. The pure files hold every decision worth
   * testing (what a payload means, which lead may be pushed); the index files
   * hold plumbing. Listing the directory wholesale would make this config fail
   * on Deno syntax and tempt somebody to delete the line.
   */
  "include": [
    "tests",
    "src",
    "supabase/functions/*/events.ts",
    "supabase/functions/*/payload.ts"
  ]
}
